theorem connected_two_regular_iso_cycleGraph
    {V : Type u} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (hc : G.Connected) (hd : ∀ x, G.degree x = 2) :
