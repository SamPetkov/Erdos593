        obtain ⟨B, rfl, haB⟩ := incidence_adj_inr h₁
        have hne₂ : (Sum.inl B : EdgeCycleBlock G ⊕ V) ≠ Sum.inr b := by simp
        obtain ⟨p₂, h₂, w₂, rfl⟩ := w₁.exists_eq_cons_of_ne hne₂
