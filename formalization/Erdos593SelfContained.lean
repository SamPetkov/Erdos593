          simp
        have ha₂ : a₂ ≠ v₀ := by
          intro h
          exact hB (h ▸ ha₂B)
        have hlen₂ : w₂.length < n := by
          simp only [Walk.length_cons] at hlen
          omega
        have hblocks₂ : ∀ C : EdgeCycleBlock G,
