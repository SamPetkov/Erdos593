      ((onePointIndecomposable_iff_of_iso i).mp hi)
    have heA : atomOf U hU.1 hU.2.1 (Sum.inl e) = A :=
      hA ⟨e, rfl, rfl⟩
    have hfA : atomOf U hU.1 hU.2.1 (Sum.inl f) = A :=
      hA ⟨f, heq.symm, rfl⟩
    exact heA.trans hfA.symm

