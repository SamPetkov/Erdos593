    have heq : (P.path i).getVert (j.val + 1) =
        (P.path i).getVert (j'.val + 1) := h
    have hj := j.isLt
    have hj' := j'.isLt
    change j.val < (P.path i).length - 1 at hj
    change j'.val < (P.path i).length - 1 at hj'
