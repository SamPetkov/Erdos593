undirected shift graph.
-/
theorem adj_of_shift {r : ℕ} (hr : 0 < r) {x y : Tuple κ r}
    (h : Shift κ x y) : (graph κ r).Adj x y := by
  -- Apply the hypothesis `h_ne` to the assumption `a`.
  apply (ne_of_shift κ hr h) |> fun h_ne => by tauto;

