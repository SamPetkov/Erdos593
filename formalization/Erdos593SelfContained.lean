theorem exists_original_partition_of_pointSeparation
    {V E : Type u} (F : TripleSystem V E) (S : Set E)
    (h : HasPointSeparation (F.edgeRestriction S)) :
    ∃ L R : Set E, L.Nonempty ∧ R.Nonempty ∧ Disjoint L R ∧
