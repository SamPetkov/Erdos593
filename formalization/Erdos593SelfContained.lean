namespace SimpleGraph

universe u

variable {V : Type u}

/-- A simple graph is two-colourable exactly when every simple cycle has even
length. -/
-- ARISTOTLE_TARGET G5
theorem two_colorable_iff_every_cycle_even (G : _root_.SimpleGraph V) :
