  Walk.not_nil_iff_lt_length.mp (Walk.not_nil_of_ne P.ends_ne)

omit [Fintype V] [DecidableEq V] [DecidableRel G.Adj] in
/-- Two length-one branches would repeat the same edge in a simple graph. -/
