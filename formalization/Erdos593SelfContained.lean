    intro z _
    cases z with
    | inl x => exact Or.inl ⟨x, rfl⟩
    | inr y => exact Or.inr ⟨y, rfl⟩
  have hdisjoint : Disjoint L R := by
    apply Set.disjoint_left.mpr
    rintro z ⟨x, rfl⟩ ⟨y, h⟩
    cases h
