  symm
  apply eq_baseApex_of_isBaseApex
  constructor
  · exact inc_mkEdge_iff.mpr (Or.inr (Or.inr rfl))
  · simpa only [baseNode_mkEdge] using (Node.ne_of_extendsBy hext).symm

