    have hsumqP :
        (∑ A ∈ p, Erdos593.Spectrum.q (r A)) =
          ∑ A ∈ atomFinset F hlinear hbridge, Erdos593.Spectrum.q (r A) := by
      simp only [hpdef, Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro A _
      by_cases hA : 0 < r A
