  apply Subtype.ext
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · rfl
  · have hover := congrArg (fun q : Tuple κ r ↦ q.1 j) h
    simpa [glue, tail, init] using hover.symm

