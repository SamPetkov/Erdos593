    rw [Fin.strictMono_iff_lt_succ]
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · have hz := (Fin.strictMono_iff_lt_succ.mp z.2) (⟨0, hr⟩ : Fin r)
