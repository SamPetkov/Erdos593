  let L : Set E := Subtype.val '' A
  let R : Set E := Subtype.val '' B
  refine ⟨L, R, hA.image _, hB.image _, ?_, ?_, r.1, ?_⟩
  · apply Set.disjoint_left.mpr
    rintro e ⟨a, ha, hae⟩ ⟨b, hb, hbe⟩
    have hab : a = b := Subtype.ext (hae.trans hbe.symm)
