      p.before (Ordinal.ToType.mk ⟨(ζ.toOrd : Ordinal), hζ⟩) := by
  apply graph_injective
  unfold before
  rw [graph_restrict, graph_restrict, graph_snoc]
  ext z
  simp only [Set.mem_inter_iff, Set.mem_union, Set.mem_singleton_iff,
