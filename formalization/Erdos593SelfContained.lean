    have hapex₁ : baseApex e = (t₁, z₁) := by
      rw [he₁]
      exact baseApex_mkEdge
    have hinc' : (system G).Inc (t₁, z₁) f := by
      rw [← hapex₁]
      exact hinc
    rw [he₂, inc_mkEdge_iff] at hinc'
