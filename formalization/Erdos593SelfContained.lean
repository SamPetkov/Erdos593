      · exact Or.inl ⟨a, ha, rfl⟩
      · exact Or.inr ⟨a, hb, rfl⟩
  · ext x
    constructor
    · rintro ⟨⟨e, ⟨a, ha, rfl⟩, hxe⟩, ⟨g, ⟨b, hb, rfl⟩, hxg⟩⟩
      let xS : F.EdgeSupport S := ⟨x, a.1, a.2, hxe⟩
      have hx : xS ∈ (F.edgeRestriction S).edgeSupportSet A ∩
          (F.edgeRestriction S).edgeSupportSet B :=
        ⟨⟨a, ha, hxe⟩, ⟨b, hb, hxg⟩⟩
