    | nil => simp at hw
    | cons hadj w' =>
        have hw' : w'.length = 0 := by simpa using hw
        cases w' with
        | nil => simp
        | cons _ _ => simp at hw'
  suffices H : ∀ (n : ℕ) (t : EdgeCycleBlock G ⊕ V) (c : (incidenceGraph G).Walk t t),
      c.length ≤ n → ¬ c.IsCycle by
    intro t c hc
